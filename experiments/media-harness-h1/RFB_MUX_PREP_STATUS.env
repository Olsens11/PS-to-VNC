# Machine-readable preparation state for the H1 RFB-over-mux experiment.
# This is experiment-local state, not runtime/PROJECT_STATE.env authority.
H1_RFB_MUX_PREP_STATUS=DOCUMENTED_READY_FOR_SOURCE_PREP
H1_RFB_MUX_PHYSICAL_STREAMS=1
H1_RFB_MUX_CHANNEL=1
H1_RFB_MUX_INITIAL_RFB_QUEUE_REFERENCE_BYTES=32768
H1_RFB_MUX_FIRST_HARDWARE_MODE=RFB_ONLY
H1_RFB_MUX_HYBRID_PRESENTATION_STATUS=DEFER_UNTIL_RFB_TRANSPORT_QUALIFIED
H1_RFB_MUX_ISSUE40_SCOPE=NO
H1_RFB_MUX_PT_LOAD_QUALIFICATION=REQUIRED_AFTER_SOURCE_CHANGE
