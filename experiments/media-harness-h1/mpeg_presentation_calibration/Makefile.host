CC ?= cc
CFLAGS ?= -std=c99 -O2 -Wall -Wextra -Werror -pedantic

CORE_SOURCES = \
	mpeg_presentation_calibration_geometry.c \
	mpeg_presentation_calibration_state.c

ENTRY_HOLD_SOURCES = \
	h1_mpeg_calibration_entry_hold.c

ADAPTER_SOURCES = \
	$(CORE_SOURCES) \
	h1_mpeg_calibration_adapter.c

FOREGROUND_SOURCES = \
	$(ADAPTER_SOURCES) \
	h1_mpeg_calibration_foreground.c

RFB_GATE_SOURCES = \
	h1_mpeg_calibration_rfb_gate.c

RFB_SCHEDULE_SOURCES = \
	$(RFB_GATE_SOURCES) \
	h1_mpeg_calibration_rfb_schedule.c

RFB_FLOW_SOURCES = \
	$(RFB_SCHEDULE_SOURCES) \
	h1_mpeg_calibration_rfb_flow.c

RENDER_SOURCES = \
	$(CORE_SOURCES) \
	h1_mpeg_calibration_render.c

RUNTIME_SOURCES = \
	$(FOREGROUND_SOURCES) \
	$(RFB_GATE_SOURCES) \
	h1_mpeg_calibration_render.c \
	h1_mpeg_calibration_runtime.c

INTERACTION_BINDING_SOURCES = \
	$(CORE_SOURCES) \
	h1_mpeg_calibration_adapter.c \
	h1_mpeg_calibration_foreground.c \
	h1_mpeg_calibration_rfb_gate.c \
	h1_mpeg_calibration_rfb_schedule.c \
	h1_mpeg_calibration_render.c \
	h1_mpeg_calibration_runtime.c \
	h1_mpeg_calibration_rfb_flow.c \
	h1_mpeg_calibration_interaction_binding.c

CORE_TEST = mpeg_presentation_calibration_test
ENTRY_HOLD_TEST = h1_mpeg_calibration_entry_hold_test
ADAPTER_TEST = h1_mpeg_calibration_adapter_test
FOREGROUND_TEST = h1_mpeg_calibration_foreground_test
RFB_GATE_TEST = h1_mpeg_calibration_rfb_gate_test
RFB_SCHEDULE_TEST = h1_mpeg_calibration_rfb_schedule_test
RFB_FLOW_TEST = h1_mpeg_calibration_rfb_flow_test
RENDER_TEST = h1_mpeg_calibration_render_test
RUNTIME_TEST = h1_mpeg_calibration_runtime_test
INTERACTION_BINDING_TEST = h1_mpeg_calibration_interaction_binding_test

.PHONY: test clean

test: $(CORE_TEST) $(ENTRY_HOLD_TEST) $(ADAPTER_TEST) $(FOREGROUND_TEST) $(RFB_GATE_TEST) $(RFB_SCHEDULE_TEST) $(RFB_FLOW_TEST) $(RENDER_TEST) $(RUNTIME_TEST) $(INTERACTION_BINDING_TEST)
	./$(CORE_TEST)
	./$(ENTRY_HOLD_TEST)
	./$(ADAPTER_TEST)
	./$(FOREGROUND_TEST)
	./$(RFB_GATE_TEST)
	./$(RFB_SCHEDULE_TEST)
	./$(RFB_FLOW_TEST)
	./$(RENDER_TEST)
	./$(RUNTIME_TEST)
	./$(INTERACTION_BINDING_TEST)
	python3 h1_mpeg_calibration_live_wiring_test.py

$(CORE_TEST): $(CORE_SOURCES) mpeg_presentation_calibration_test.c
	$(CC) $(CFLAGS) -I. $(CORE_SOURCES) mpeg_presentation_calibration_test.c -o $@

$(ENTRY_HOLD_TEST): $(ENTRY_HOLD_SOURCES) h1_mpeg_calibration_entry_hold_test.c
	$(CC) $(CFLAGS) -I. $(ENTRY_HOLD_SOURCES) h1_mpeg_calibration_entry_hold_test.c -o $@

$(ADAPTER_TEST): $(ADAPTER_SOURCES) h1_mpeg_calibration_adapter_test.c
	$(CC) $(CFLAGS) -I. -I../../../src/input $(ADAPTER_SOURCES) h1_mpeg_calibration_adapter_test.c -o $@

$(FOREGROUND_TEST): $(FOREGROUND_SOURCES) h1_mpeg_calibration_foreground_test.c
	$(CC) $(CFLAGS) -I. -I../../../src/input $(FOREGROUND_SOURCES) h1_mpeg_calibration_foreground_test.c -o $@

$(RFB_GATE_TEST): $(RFB_GATE_SOURCES) h1_mpeg_calibration_rfb_gate_test.c
	$(CC) $(CFLAGS) -I. $(RFB_GATE_SOURCES) h1_mpeg_calibration_rfb_gate_test.c -o $@

$(RFB_SCHEDULE_TEST): $(RFB_SCHEDULE_SOURCES) h1_mpeg_calibration_rfb_schedule_test.c
	$(CC) $(CFLAGS) -I. $(RFB_SCHEDULE_SOURCES) h1_mpeg_calibration_rfb_schedule_test.c -o $@

$(RFB_FLOW_TEST): $(RFB_FLOW_SOURCES) h1_mpeg_calibration_rfb_flow_test.c
	$(CC) $(CFLAGS) -I. -I../../../src/input -I../../../src/framebuffer -I../../../src/rfb $(RFB_FLOW_SOURCES) h1_mpeg_calibration_rfb_flow_test.c -o $@

$(RENDER_TEST): $(RENDER_SOURCES) h1_mpeg_calibration_render_test.c
	$(CC) $(CFLAGS) -I. $(RENDER_SOURCES) h1_mpeg_calibration_render_test.c -o $@

$(RUNTIME_TEST): $(RUNTIME_SOURCES) h1_mpeg_calibration_runtime_test.c
	$(CC) $(CFLAGS) -I. -I../../../src/input $(RUNTIME_SOURCES) h1_mpeg_calibration_runtime_test.c -o $@

$(INTERACTION_BINDING_TEST): $(INTERACTION_BINDING_SOURCES) h1_mpeg_calibration_interaction_binding_test.c
	$(CC) $(CFLAGS) -I. -Ihost_stubs -I../../../src/input -I../../../src/framebuffer -I../../../src/rfb $(INTERACTION_BINDING_SOURCES) h1_mpeg_calibration_interaction_binding_test.c -o $@

clean:
	rm -f $(CORE_TEST) $(ENTRY_HOLD_TEST) $(ADAPTER_TEST) $(FOREGROUND_TEST) $(RFB_GATE_TEST) $(RFB_SCHEDULE_TEST) $(RFB_FLOW_TEST) $(RENDER_TEST) $(RUNTIME_TEST) $(INTERACTION_BINDING_TEST)
