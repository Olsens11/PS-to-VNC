CC ?= cc
CFLAGS ?= -std=c99 -O2 -Wall -Wextra -Werror -pedantic
SOURCES = mpeg_presentation_calibration_geometry.c mpeg_presentation_calibration_state.c
TEST = mpeg_presentation_calibration_test
.PHONY: test clean
test: $(TEST)
	./$(TEST)
$(TEST): $(SOURCES) mpeg_presentation_calibration_test.c
	$(CC) $(CFLAGS) -I. $(SOURCES) mpeg_presentation_calibration_test.c -o $@
clean:
	rm -f $(TEST)
