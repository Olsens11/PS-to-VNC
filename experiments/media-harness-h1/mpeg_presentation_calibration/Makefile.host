CC ?= cc
CFLAGS ?= -std=c99 -O2 -Wall -Wextra -Werror -pedantic

CORE_SOURCES = \
	mpeg_presentation_calibration_geometry.c \
	mpeg_presentation_calibration_state.c

ADAPTER_SOURCES = \
	$(CORE_SOURCES) \
	h1_mpeg_calibration_adapter.c

FOREGROUND_SOURCES = \
	$(ADAPTER_SOURCES) \
	h1_mpeg_calibration_foreground.c

RFB_GATE_SOURCES = \
	h1_mpeg_calibration_rfb_gate.c

RENDER_SOURCES = \
	$(CORE_SOURCES) \
	h1_mpeg_calibration_render.c

RUNTIME_SOURCES = \
	$(FOREGROUND_SOURCES) \
	$(RFB_GATE_SOURCES) \
	h1_mpeg_calibration_render.c \
	h1_mpeg_calibration_runtime.c

CORE_TEST = mpeg_presentation_calibration_test
ADAPTER_TEST = h1_mpeg_calibration_adapter_test
FOREGROUND_TEST = h1_mpeg_calibration_foreground_test
RFB_GATE_TEST = h1_mpeg_calibration_rfb_gate_test
RENDER_TEST = h1_mpeg_calibration_render_test
RUNTIME_TEST = h1_mpeg_calibration_runtime_test

.PHONY: test clean

test: $(CORE_TEST) $(ADAPTER_TEST) $(FOREGROUND_TEST) $(RFB_GATE_TEST) $(RENDER_TEST) $(RUNTIME_TEST)
	./$(CORE_TEST)
	./$(ADAPTER_TEST)
	./$(FOREGROUND_TEST)
	./$(RFB_GATE_TEST)
	./$(RENDER_TEST)
	./$(RUNTIME_TEST)

$(CORE_TEST): $(CORE_SOURCES) mpeg_presentation_calibration_test.c
	$(CC) $(CFLAGS) -I. $(CORE_SOURCES) mpeg_presentation_calibration_test.c -o $@

$(ADAPTER_TEST): $(ADAPTER_SOURCES) h1_mpeg_calibration_adapter_test.c
	$(CC) $(CFLAGS) -I. -I../../../src/input $(ADAPTER_SOURCES) h1_mpeg_calibration_adapter_test.c -o $@

$(FOREGROUND_TEST): $(FOREGROUND_SOURCES) h1_mpeg_calibration_foreground_test.c
	$(CC) $(CFLAGS) -I. -I../../../src/input $(FOREGROUND_SOURCES) h1_mpeg_calibration_foreground_test.c -o $@

$(RFB_GATE_TEST): $(RFB_GATE_SOURCES) h1_mpeg_calibration_rfb_gate_test.c
	$(CC) $(CFLAGS) -I. $(RFB_GATE_SOURCES) h1_mpeg_calibration_rfb_gate_test.c -o $@

$(RENDER_TEST): $(RENDER_SOURCES) h1_mpeg_calibration_render_test.c
	$(CC) $(CFLAGS) -I. $(RENDER_SOURCES) h1_mpeg_calibration_render_test.c -o $@

$(RUNTIME_TEST): $(RUNTIME_SOURCES) h1_mpeg_calibration_runtime_test.c
	$(CC) $(CFLAGS) -I. -I../../../src/input $(RUNTIME_SOURCES) h1_mpeg_calibration_runtime_test.c -o $@

clean:
	rm -f $(CORE_TEST) $(ADAPTER_TEST) $(FOREGROUND_TEST) $(RFB_GATE_TEST) $(RENDER_TEST) $(RUNTIME_TEST)
