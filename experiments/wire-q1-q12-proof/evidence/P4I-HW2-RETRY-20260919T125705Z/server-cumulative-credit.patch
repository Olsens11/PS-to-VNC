+def expect_credit_total(
+    connection: socket.socket,
+    sequence: int,
+    channel: int,
+    total_amount: int,
+) -> tuple[int, list[int], list[int]]:
+    if total_amount <= 0:
+        raise ProofError(
+            f"invalid cumulative credit target {total_amount}"
+        )
+
+    sequences: list[int] = []
+    amounts: list[int] = []
+    accumulated = 0
+
+    while accumulated < total_amount:
+        kind, got_channel, flags, payload = recv_frame(
+            connection,
+            sequence,
+        )
+
+        if (
+            kind != FRAME_CREDIT
+            or got_channel != channel
+            or flags != 0
+        ):
+            raise ProofError(
+                "expected cumulative CREDIT "
+                f"seq={sequence} channel={channel}; "
+                f"got kind={kind} channel={got_channel} "
+                f"flags={flags}"
+            )
+
+        amount = decode_credit(payload)
+
+        if amount <= 0:
+            raise ProofError(
+                f"zero cumulative credit at seq={sequence}"
+            )
+
+        if accumulated + amount > total_amount:
+            raise ProofError(
+                "cumulative credit exceeded target "
+                f"seq={sequence} amount={amount} "
+                f"accumulated={accumulated} "
+                f"target={total_amount}"
+            )
+
+        sequences.append(sequence)
+        amounts.append(amount)
+        accumulated += amount
+        sequence += 1
+
+    return sequence, sequences, amounts
+
