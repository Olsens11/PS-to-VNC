SOURCE_PANEL_DEFAULT_SHA256=d87c2e529d852a989364d1f701a6ccc34b070e3cbcd8398bf8a91535257953e8
SOURCE_PANEL_PROFILE=/etc/xdg/lxpanel-pi/panels/panel
SOURCE_PANEL_PROFILE_SHA256=0f14cfff832d83f01541face8d1f840eb33c4b44f72ffb35910023c2434b0595
TARGET_PANEL=lxpanel-pi
GENERIC_LXPANEL_TARGET=NO
