[Unit]
Description=PS-to-VNC persistent product Wire server
Documentation=https://github.com/Olsens11/PS-to-VNC/blob/ledge/h1-all-guns/docs/pi/README.md
After=network.target

[Service]
Type=simple
User=ps2
Group=ps2
WorkingDirectory=/usr/lib/ps-to-vnc
ExecStart=/usr/bin/python3 /usr/lib/ps-to-vnc/wire_server.py --listen 192.168.50.1 --port 5902
Restart=on-failure
RestartSec=1s

# The product Wire process owns its own listener and every accepted physical
# connection. systemd supervises the process but does not socket-activate it.
# RFB provider lifecycle remains independent and is not required by this unit.

[Install]
WantedBy=multi-user.target
