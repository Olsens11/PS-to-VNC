[Unit]
Description=PS-to-VNC socket-activated TigerVNC RFB provider
Documentation=https://github.com/Olsens11/PS-to-VNC/blob/pi/issue5-rfb-socket-activation-candidate/docs/pi/RFB_SOCKET_ACTIVATION.md
Requires=ps-to-vnc-rfb.socket
After=ps-to-vnc-rfb.socket

[Service]
Type=simple
User=ps2
Group=ps2
WorkingDirectory=/home/ps2
UMask=0077
StandardInput=socket
StandardOutput=journal
ExecStart=/usr/bin/Xtigervnc :1 -inetd -geometry 704x462 -depth 16 -pixelformat RGB565 -SecurityTypes None -AcceptSetDesktopSize=0 -UseIPv6=0 -nolisten tcp -Log *:syslog:30

# This unit is the current provider implementation behind the generic
# ps-to-vnc-rfb.socket contract. TigerVNC is not part of the permanent socket
# boundary: a future provider may replace this unit while retaining the same
# PS2-facing RFB listener contract.
#
# Restart policy is intentionally left unset while Issue #5 validates socket
# retrigger, controlled failure, and desktop-persistence semantics. The socket
# remains the demand-ready authority if this service exits.
