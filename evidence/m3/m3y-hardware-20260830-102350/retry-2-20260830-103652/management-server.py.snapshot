LEGACY_DISPLAY_MODE = "1080i"

DISPLAY_KEYS = (
    "safe_width",
    "safe_height",
    "safe_x",
    "safe_y",
)

STARTUP_MODE_KEY = "startup_mode"
DISPLAY_LOCK_KEY = "locked"
HIDE_LOCKED_MODES_KEY = "hide_locked_modes"


def parse_display_update(text):
    values = {}
    mode_name = None
    explicit_mode = False

    for raw_line in text.splitlines():
        line = raw_line.strip()

        if not line:
            continue

        if "=" not in line:
            raise ValueError("invalid line")

        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()

        if key == "mode":
            if explicit_mode:
                raise ValueError("duplicate mode")
            if value not in DISPLAY_MODES:
                raise ValueError("unsupported display mode")
            mode_name = value
            explicit_mode = True
            continue

        if key not in DISPLAY_KEYS:
            raise ValueError("unknown key")

        if key in values:
            raise ValueError("duplicate key")

        if key in ("safe_width", "safe_height"):
            if not re.fullmatch(r"[0-9]+", value):
                raise ValueError("invalid size")
        else:
            if not re.fullmatch(r"-?[0-9]+", value):
                raise ValueError("invalid offset")

        values[key] = int(value)

    if set(values) != set(DISPLAY_KEYS):
        raise ValueError("incomplete display update")

    if mode_name is None:
        mode_name = LEGACY_DISPLAY_MODE

    return mode_name, explicit_mode, values



def parse_startup_mode_update(text):
    mode_name = None

    for raw_line in text.splitlines():
        line = raw_line.strip()

        if not line:
            continue

        if "=" not in line:
            raise ValueError("invalid line")

        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()

        if key != STARTUP_MODE_KEY:
            raise ValueError("unknown key")

        if mode_name is not None:
            raise ValueError("duplicate startup_mode")

        if value not in DISPLAY_MODES:
            raise ValueError("unsupported display mode")

        mode_name = value

    if mode_name is None:
        raise ValueError("missing startup_mode")

    return mode_name



def parse_boolean(value):
    normalized = value.strip().lower()

    if normalized in ("true", "1", "yes", "on"):
        return True

    if normalized in ("false", "0", "no", "off"):
        return False

    raise ValueError("invalid boolean")


def parse_mode_lock_update(text):
    values = {}

    for raw_line in text.splitlines():
        line = raw_line.strip()

        if not line:
            continue

        if "=" not in line:
            raise ValueError("invalid line")

        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()

        if key in values:
            raise ValueError(f"duplicate {key}")

        if key not in ("mode", DISPLAY_LOCK_KEY):
            raise ValueError("unknown key")

        values[key] = value

    if set(values) != {"mode", DISPLAY_LOCK_KEY}:
        raise ValueError("incomplete display lock update")

    mode_name = values["mode"]

    if mode_name not in DISPLAY_MODES:
        raise ValueError("unsupported display mode")

    locked = parse_boolean(
        values[DISPLAY_LOCK_KEY]
    )

    return mode_name, locked


def parse_display_ui_update(text):
    values = {}

    for raw_line in text.splitlines():
        line = raw_line.strip()

        if not line:
            continue

        if "=" not in line:
            raise ValueError("invalid line")

        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()

        if key in values:
            raise ValueError(f"duplicate {key}")

        if key != HIDE_LOCKED_MODES_KEY:
            raise ValueError("unknown key")

        values[key] = value

    if set(values) != {HIDE_LOCKED_MODES_KEY}:
        raise ValueError("incomplete display UI update")

    return parse_boolean(
        values[HIDE_LOCKED_MODES_KEY]
    )


def validate_display(values, mode_name):
    if mode_name not in DISPLAY_MODES:
        raise ValueError("unsupported display mode")

    output_width, output_height = DISPLAY_MODES[mode_name]

    safe_width = values["safe_width"]
    safe_height = values["safe_height"]
    safe_x = values["safe_x"]
    safe_y = values["safe_y"]

    if safe_width <= 0 or safe_height <= 0:
        raise ValueError("non-positive size")

    if safe_width > output_width or safe_height > output_height:
        raise ValueError("display too large")

    left = ((output_width - safe_width) // 2) + safe_x
    top = ((output_height - safe_height) // 2) + safe_y

    if left < 0 or top < 0:
        raise ValueError("display outside output")

    if left + safe_width > output_width:
        raise ValueError("display outside output")

    if top + safe_height > output_height:
        raise ValueError("display outside output")

